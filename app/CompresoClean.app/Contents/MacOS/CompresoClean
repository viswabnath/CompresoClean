    echo "  SDK emulator images were found. Both are fully regenerated on next"
    echo "  use (Xcode/sdkmanager re-download the OS image; recreating a"
    echo "  device from its saved config takes under a minute) -- but if"
    echo "  you'd rather keep them configured as-is, skip this."
    read -rp "  Delete ALL iOS simulators + Android emulators? [y/N] " WIPE_INPUT
