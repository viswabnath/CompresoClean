# ── Smart Scan: heaviest apps ────────────────────────────────────────────────
# Generic scan across every installed app (not just the curated list above).
# Only ever touches caches/logs/saved-state/container-cache/junk subfolders --
# never the app bundle itself and never real user data in Application Support.
echo "-- Smart Scan: Heaviest Apps --"
echo "  scanning installed apps (this can take a minute)..."

# Sums du -sm (MB) across every existing path passed in; 0 if none exist
sum_size_mb() {
    local total=0 p sz
    for p in "$@"; do
        [ -e "$p" ] || continue
        sz=$(du -sm "$p" 2>/dev/null | awk '{print $1}')
        [ -n "$sz" ] && total=$((total + sz))
    done
    echo "$total"
}

# Prints candidate junk paths for one app, one per line. Requires a non-empty
# app_name -- an empty app_name would otherwise widen the Logs/App Support
# globs below to match every app's files, not just this one.
junk_paths_for_app() {
    local bundle_id="$1" app_name="$2" f
    [ -z "$app_name" ] && return

    if [ -n "$bundle_id" ]; then
        for f in "$HOME"/Library/Caches/"$bundle_id"*; do printf '%s\n' "$f"; done
        for f in "$HOME"/Library/Saved\ Application\ State/"$bundle_id"*.savedState; do printf '%s\n' "$f"; done
        for f in "$HOME"/Library/Containers/"$bundle_id"/Data/Library/Caches/*; do printf '%s\n' "$f"; done
    fi
    for f in "$HOME"/Library/Logs/"$app_name"*; do printf '%s\n' "$f"; done

    if [ -d "$HOME/Library/Application Support/$app_name" ]; then
        find "$HOME/Library/Application Support/$app_name" -maxdepth 2 -type d \
            \( -iname "Cache" -o -iname "Caches" -o -iname "Cache Files" \
               -o -iname "GPUCache" -o -iname "Code Cache" -o -iname "tmp" -o -iname "temp" \) \
            2>/dev/null
    fi
}

SCAN_REPORT="$HOME/.compresoclean_scan.tmp"
INSTALLED_IDS="$HOME/.compresoclean_ids.tmp"   # reused by the orphan finder below
> "$SCAN_REPORT"
> "$INSTALLED_IDS"

# .app dirs at any depth, but pruned so we don't descend into a match
# (handles nested installs like "Adobe Photoshop 2025/Adobe Photoshop 2025.app")
APP_PATHS_LIST=$(find /Applications "$HOME/Applications" \( -iname "*.app" -type d \) -prune -print 2>/dev/null)

while IFS= read -r app; do
    [ -z "$app" ] && continue
    app_name=$(basename "$app" .app)
    bundle_id=$(defaults read "$app/Contents/Info" CFBundleIdentifier 2>/dev/null)
    [ -n "$bundle_id" ] && echo "$bundle_id" >> "$INSTALLED_IDS"

    junk=()
    while IFS= read -r junk_line; do junk+=("$junk_line"); done < <(junk_paths_for_app "$bundle_id" "$app_name")
    [ "${#junk[@]}" -eq 0 ] && continue
    junk_mb=$(sum_size_mb "${junk[@]}")
    [ "$junk_mb" -lt 1 ] && continue

    app_mb=$(du -sm "$app" 2>/dev/null | awk '{print $1}')
    echo "${junk_mb}|${app_mb:-0}|${app_name}|${bundle_id}" >> "$SCAN_REPORT"
done <<< "$APP_PATHS_LIST"

sort -t'|' -k1 -n -r "$SCAN_REPORT" -o "$SCAN_REPORT"
TOP_REPORT=$(head -15 "$SCAN_REPORT")
rm -f "$SCAN_REPORT"

if [ -z "$TOP_REPORT" ]; then
    echo "  no additional reclaimable app data found."
    echo ""
else
    declare -a SCAN_NAMES=() SCAN_BUNDLES=() SCAN_LABELS=()
    while IFS='|' read -r jmb amb aname bid; do
        [ -z "$aname" ] && continue
        SCAN_NAMES+=("$aname")
        SCAN_BUNDLES+=("$bid")
        SCAN_LABELS+=("${aname} -- ${jmb} MB reclaimable (app ${amb} MB)")
    done <<< "$TOP_REPORT"

    echo "  heaviest apps found:"
    idx=1
    for label in "${SCAN_LABELS[@]}"; do
        printf '   %2d) %s\n' "$idx" "$label"
        idx=$((idx + 1))
    done
    echo ""

    # Numbered picker instead of a GUI list -- "choose from list" only supports
    # multi-select via Cmd/Shift-click, which isn't discoverable and reads as
    # broken. Typing comma-separated numbers works the same way for 1 or many.
    read -rp "  Enter numbers to clean (e.g. 1,3,5), 'all', or press Enter to skip: " SEL_INPUT

    declare -a SELECTED_INDICES=()
    if [ -z "$SEL_INPUT" ]; then
        :
    elif [ "$(printf '%s' "$SEL_INPUT" | tr '[:upper:]' '[:lower:]')" = "all" ]; then
        SELECTED_INDICES=("${!SCAN_LABELS[@]}")
    else
        IFS=',' read -ra RAW_NUMS <<< "$SEL_INPUT"
        for n in "${RAW_NUMS[@]}"; do
            n=$(printf '%s' "$n" | tr -d '[:space:]')
            [[ "$n" =~ ^[0-9]+$ ]] || continue
            [ "$n" -ge 1 ] && [ "$n" -le "${#SCAN_LABELS[@]}" ] && SELECTED_INDICES+=($((n - 1)))
        done
    fi

    if [ "${#SELECTED_INDICES[@]}" -gt 0 ]; then
        echo "  cleaning selected apps..."
        for i in "${SELECTED_INDICES[@]}"; do
            sname="${SCAN_NAMES[$i]}"
            sbid="${SCAN_BUNDLES[$i]}"
            echo "  cleaning: $sname"
            sjunk=()
            while IFS= read -r sjunk_line; do sjunk+=("$sjunk_line"); done < <(junk_paths_for_app "$sbid" "$sname")
            for jp in "${sjunk[@]}"; do
                [ -e "$jp" ] && rmx "$jp"
            done
            say_done "$sname"
            log_ok "Smart Scan: $sname"
        done
    else
        echo "  no apps selected -- skipping."
    fi
    echo ""
fi

# ── Large files (report only) ─────────────────────────────────────────────────
echo "-- Large Files (report only -- never deleted) --"
LARGE_FILES=$(find "$HOME" \( -path "$HOME/Library/CloudStorage" -o -path "$HOME/Library/Mobile Documents" \
        -o -path "$HOME/.Trash" -o -name "*.photoslibrary" -o -name "*.app" \) -prune \
        -o -type f -size +200M -print0 2>/dev/null \
    | xargs -0 stat -f '%z|%Sm|%N' -t '%Y-%m-%d' 2>/dev/null \
    | sort -t'|' -k1,1 -nr | head -15)
if [ -z "$LARGE_FILES" ]; then
    echo "  no files over 200 MB found."
else
    echo "  largest files over 200 MB (review and delete manually if unneeded):"
    while IFS='|' read -r bytes mdate fpath; do
        printf '   %6s MB  %s  %s\n' "$((bytes / 1048576))" "$mdate" "$fpath"
    done <<< "$LARGE_FILES"
fi
echo ""

# ── Orphaned app data (report only) ───────────────────────────────────────────
# Leftovers in ~/Library from apps that are no longer installed. Conservative:
# an item is only flagged when NO installed app shares its vendor prefix (first
# two bundle-ID components), so e.g. com.google.* is never flagged while any
# Google app is installed. Apple items are skipped. Nothing is deleted.
echo "-- Orphaned App Data (report only -- never deleted) --"
ORPHAN_VENDORS="$HOME/.compresoclean_vendors.tmp"
ORPHAN_REPORT="$HOME/.compresoclean_orphans.tmp"
awk -F. 'NF>=2 {print tolower($1"."$2)}' "$INSTALLED_IDS" | sort -u > "$ORPHAN_VENDORS"
> "$ORPHAN_REPORT"
for f in "$HOME"/Library/Application\ Support/* "$HOME"/Library/Containers/* \
         "$HOME"/Library/Saved\ Application\ State/* "$HOME"/Library/Preferences/*.plist \
         "$HOME"/Library/HTTPStorages/* "$HOME"/Library/WebKit/*; do
    name=$(basename "$f"); name="${name%.plist}"; name="${name%.savedState}"
    [[ "$name" =~ ^[A-Za-z0-9-]+\.[A-Za-z0-9-]+\.[A-Za-z0-9._-]+$ ]] || continue
    case "$name" in com.apple.*|group.com.apple.*|systemgroup.*) continue ;; esac
    vendor=$(printf '%s' "$name" | awk -F. '{print tolower($1"."$2)}')
    grep -qxF "$vendor" "$ORPHAN_VENDORS" && continue
    okb=$(du -sk "$f" 2>/dev/null | awk '{print $1}')
    echo "${okb:-0}|$f" >> "$ORPHAN_REPORT"
done
ORPHANS=$(sort -t'|' -k1,1 -nr "$ORPHAN_REPORT" | head -20)
rm -f "$ORPHAN_VENDORS" "$ORPHAN_REPORT" "$INSTALLED_IDS"
if [ -z "$ORPHANS" ]; then
    echo "  no likely orphaned app data found."
else
    echo "  possible leftovers from uninstalled apps (heuristic -- review before removing):"
    while IFS='|' read -r okb opath; do
        printf '   %6s MB  %s\n' "$((okb / 1024))" "$opath"
    done <<< "$ORPHANS"
fi
echo ""

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
if [ "$DRY_RUN" = "1" ]; then
    DRY_MB=$(( $(dry_total_kb) / 1024 ))
    rm -f "$DRY_TALLY"
    echo "DRY RUN complete -- nothing was deleted."
    echo "Would free approximately: ${DRY_MB} MB"
    echo "(estimate; brew cleanup and simulator runtime images are not counted)"
    echo ""
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] CompresoClean v${VERSION} -- Dry run. ~${DRY_MB} MB reclaimable." >> "$LOGFILE"
    osascript -e "display notification \"Would free about ${DRY_MB} MB. Nothing was deleted.\" with title \"CompresoClean v${VERSION}\" subtitle \"Dry run complete\""
else
    rm -f "$DRY_TALLY"
    AFTER_AVAIL=$(df / | tail -1 | awk '{print $4}')
    MB_FREED=$(( (AFTER_AVAIL - BEFORE_AVAIL) / 2048 ))

    echo "AFTER:"; df -h /; echo ""
    echo "Space freed: ${MB_FREED} MB"
    echo ""
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] CompresoClean v${VERSION} -- Cleanup complete. ${MB_FREED} MB freed." >> "$LOGFILE"
    [ "$TRASH_MODE" = "1" ] && echo "Trash mode: moved items are in ~/.Trash. Empty the Trash to reclaim the space."
    echo "Log saved to ~/.compresoclean.log"
    echo "Cleanup complete."

    osascript -e "display notification \"Freed ${MB_FREED} MB of disk space.\" with title \"CompresoClean v${VERSION}\" subtitle \"Cleanup complete\""
fi
rm -f ~/.compresoclean_runner.sh
CLEANSCRIPT

chmod +x ~/.compresoclean_runner.sh

osascript -e 'tell application "Terminal"
    activate
    do script "DRY_RUN='"$DRY_RUN"' TRASH_MODE='"$TRASH_MODE"' CC_VERSION='"$VERSION"' ~/.compresoclean_runner.sh"
end tell'
