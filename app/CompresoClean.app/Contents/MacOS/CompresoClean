#!/bin/bash

VERSION="1.5"

# --dry-run skips the dialog and previews only; the dialog also offers a
# "Preview (Dry Run)" button. A dry run deletes nothing and reports what a
# real run would remove and roughly how much space that would free.
# --trash moves deletions to ~/.Trash (recoverable) instead of removing them.
DRY_RUN=0
TRASH_MODE=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --trash)   TRASH_MODE=1 ;;
    esac
done
if [ "$DRY_RUN" != "1" ]; then
    CONFIRM=$(osascript -e "button returned of (display dialog \"CompresoClean v${VERSION}\n\nReady to clean your Mac?\n\nDetects all installed creative apps automatically, plus a Smart Scan that finds your heaviest apps and lets you pick which ones to clean.\n\nPreview shows what would be removed without deleting anything.\" buttons {\"Cancel\", \"Preview (Dry Run)\", \"Clean Now\"} default button \"Clean Now\" with title \"CompresoClean v${VERSION}\")")

    case "$CONFIRM" in
        "Clean Now") ;;
        "Preview (Dry Run)") DRY_RUN=1 ;;
        *) exit 0 ;;
    esac
fi

# Write runner to home dir — /tmp gets wiped during cleanup
cat > ~/.compresoclean_runner.sh << 'CLEANSCRIPT'
#!/bin/bash

# Unmatched globs expand to nothing instead of erroring
shopt -s nullglob

LOGFILE="$HOME/.compresoclean.log"
VERSION="${CC_VERSION:-1.5}"
DRY_RUN="${DRY_RUN:-0}"
DRY_TALLY="$HOME/.compresoclean_dry.tmp"

echo "CompresoClean v${VERSION} -- by Viswanath"
[ "$DRY_RUN" = "1" ] && echo "*** DRY RUN -- nothing will be deleted ***"
echo "======================================="
echo ""

# ── Dry-run aware helpers ─────────────────────────────────────────────────────
# rmx replaces `rm -rf` everywhere. In a dry run it records each existing path's
# size instead of deleting it; items >= 10 MB are listed individually.
> "$DRY_TALLY"
TRASH_MODE="${TRASH_MODE:-0}"
RMX_PERMANENT=0   # `RMX_PERMANENT=1 rmx ...` forces a real delete (used to empty the Trash)
rmx() {
    local p kb dest name
    if [ "$DRY_RUN" != "1" ]; then
        if [ "$TRASH_MODE" != "1" ] || [ "$RMX_PERMANENT" = "1" ]; then
            rm -rf "$@"
            return 0
        fi
        # Trash mode: move anything under $HOME into ~/.Trash so it can be put
        # back. Paths outside $HOME (e.g. /tmp) are removed normally. If a move
        # fails, the item is left in place rather than silently deleted.
        for p in "$@"; do
            [ -e "$p" ] || [ -L "$p" ] || continue
            case "$p" in
                "$HOME"/.Trash/*) rm -rf "$p" ;;
                "$HOME"/*)
                    name=$(basename "$p"); name="${name#.}"
                    dest="$HOME/.Trash/${name} $(date +%H%M%S)-$RANDOM"
                    mv "$p" "$dest" 2>/dev/null || echo "    kept (could not move to Trash): $p"
                    ;;
                *) rm -rf "$p" ;;
            esac
        done
        return 0
    fi
    for p in "$@"; do
        [ -e "$p" ] || [ -L "$p" ] || continue
        kb=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
        kb=${kb:-0}
        printf '%s\t%s\t%s\n' "${#p}" "$kb" "$p" >> "$DRY_TALLY"
        [ "$kb" -ge 10240 ] && printf '    would remove: %s (%s MB)\n' "$p" "$((kb / 1024))"
    done
    return 0
}

# Total reclaimable KB for a dry run. Counts each path once and skips anything
# nested inside an already-counted directory (e.g. Caches/* then Caches/Google/x).
dry_total_kb() {
    sort -n -t$'\t' -k1,1 "$DRY_TALLY" | awk -F'\t' '
        { p=$3; skip=0; q=p
          if (p in kept) skip=1
          while (!skip && (i=match(q, "/[^/]*$")) > 1) { q=substr(q, 1, i-1); if (q in kept) skip=1 }
          if (!skip) { kept[p]=1; sum+=$2 } }
        END { print sum+0 }'
}

say_done() {
    if [ "$DRY_RUN" = "1" ]; then echo "  would clean: $1"; else echo "  done:  $1"; fi
}

log_ok() {
    [ "$DRY_RUN" = "1" ] || echo "  [ok] $1" >> "$LOGFILE"
}

# ── Detection helpers ─────────────────────────────────────────────────────────

# Finds app by display name, trying year suffixes (2026 -> 2022) then bare name
detect_by_name() {
    local name="$1"
    local result
    for suffix in " 2026" " 2025" " 2024" " 2023" " 2022" ""; do
        result=$(mdfind "kMDItemKind == 'Application' && kMDItemDisplayName == '${name}${suffix}'" 2>/dev/null | head -1)
        [ -n "$result" ] && echo "$result" && return 0
    done
    return 1
}

# Finds app by bundle identifier (more reliable than display name)
detect_by_bundle() {
    mdfind "kMDItemCFBundleIdentifier == '$1'" 2>/dev/null | head -1
}

_APP_NAME=""
_APP_FOUND=""
begin_app() {
    _APP_NAME="$1"
    _APP_FOUND="$2"
    if [ -n "$_APP_FOUND" ]; then
        echo "  found: $_APP_NAME"
        return 0
    else
        echo "  skip:  $_APP_NAME (not installed)"
        return 1
    fi
}

log_done() {
    say_done "$_APP_NAME"
    log_ok "$_APP_NAME"
}

# ── Trash mode ────────────────────────────────────────────────────────────────
# Optional: move cleaned items to the Trash instead of deleting them, so a
# mistake can be undone. Space is only reclaimed once the Trash is emptied.
if [ "$DRY_RUN" != "1" ] && [ "$TRASH_MODE" != "1" ]; then
    read -rp "Move items to Trash (recoverable) instead of deleting permanently? [y/N] " TRASH_INPUT
    [ "$(printf '%s' "$TRASH_INPUT" | tr '[:upper:]' '[:lower:]')" = "y" ] && TRASH_MODE=1
    echo ""
fi
[ "$TRASH_MODE" = "1" ] && [ "$DRY_RUN" != "1" ] && echo "*** TRASH MODE -- items are moved to ~/.Trash; empty it to reclaim space ***" && echo ""

# ── Disk baseline ─────────────────────────────────────────────────────────────
BEFORE_AVAIL=$(df / | tail -1 | awk '{print $4}')
echo "BEFORE:"; df -h /; echo ""

# ── Standard cleanup ──────────────────────────────────────────────────────────
echo "-- Standard Cleanup --"
# Empty the existing Trash first: in Trash mode, items moved there below must survive.
echo "  trash..."        && RMX_PERMANENT=1 rmx "$HOME"/.Trash/* && say_done "trash"
echo "  user caches..."  && { [ "$DRY_RUN" = "1" ] || chmod -R u+w "$HOME"/Library/Caches/* 2>/dev/null; }; rmx "$HOME"/Library/Caches/* && say_done "user caches"
echo "  user logs..."    && rmx "$HOME"/Library/Logs/* && say_done "user logs"
echo "  npm cache..."
if [ "$DRY_RUN" = "1" ]; then
    rmx "$HOME"/.npm/_cacache && say_done "npm cache"
else
    npm cache clean --force 2>/dev/null && echo "  done"
fi
echo "  homebrew..."
if [ "$DRY_RUN" = "1" ]; then
    echo "  would run: brew cleanup -s (size not estimated)"
else
    brew cleanup -s 2>/dev/null && echo "  done"
fi
echo "  temp files..."   && rmx /tmp/* /private/var/tmp/* && say_done "temp files"
echo ""

# ── Package manager & container caches ────────────────────────────────────────
echo "-- Package Manager & Container Caches --"

if command -v pnpm >/dev/null 2>&1 || [ -d "$HOME/Library/pnpm/store" ]; then
    echo "  found: pnpm store"
    PNPM_STORE=$(pnpm store path 2>/dev/null)
    rmx "${PNPM_STORE:-$HOME/Library/pnpm/store}"
    say_done "pnpm store"
    log_ok "pnpm store"
fi

# Yarn classic's cache (~/Library/Caches/Yarn) is already covered by user
# caches above; this adds Yarn Berry's global cache and a custom cache dir.
if command -v yarn >/dev/null 2>&1 || [ -d "$HOME/.yarn/berry/cache" ]; then
    echo "  found: yarn cache"
    YARN_CACHE=$(yarn cache dir 2>/dev/null | tail -1)
    [ -n "$YARN_CACHE" ] && [ -d "$YARN_CACHE" ] && rmx "$YARN_CACHE"
    rmx "$HOME"/.yarn/berry/cache
    say_done "yarn cache"
    log_ok "yarn cache"
fi

# Docker: only dangling images and build cache. Running/stopped containers and
# volumes are never touched. Docker Desktop's disk image does not shrink on its
# own after a prune; the space is reusable inside Docker.
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo "  found: Docker"
    if [ "$DRY_RUN" = "1" ]; then
        docker system df 2>/dev/null | sed 's/^/    /'
        echo "  would run: docker image prune -f; docker builder prune -f (sizes above, not added to total)"
    else
        docker image prune -f >/dev/null 2>&1
        docker builder prune -f >/dev/null 2>&1
        say_done "Docker (dangling images + build cache)"
        log_ok "Docker"
    fi
fi
echo ""

